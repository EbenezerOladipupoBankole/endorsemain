rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in
        ['bankoleebenezer111@gmail.com', 'omakaoe@gmail.com', 'ayindeenny112@gmail.com'];
    }

    function isWhatsAppSigner(docId) {
      return isSignedIn() && request.auth.uid == ('whatsapp-signer-' + docId);
    }

    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Fields that must never be settable directly by a client — they are only
    // ever written by trusted server code (Cloud Functions using the Admin SDK,
    // which bypasses these rules entirely).
    // Plan and free-document usage are only ever written by Cloud Functions.
    function protectedUserFields() {
      return ['plan', 'stripeCustomerId', 'teamId', 'planExpiresAt', 'planReminderSent', 'freeDocsUsed'];
    }

    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) &&
        !request.resource.data.keys().hasAny(protectedUserFields());
      allow update: if isAdmin() || (isSelf(userId) && !touchesProtectedUserFields());
      allow delete: if false;
    }

    // The person a document was sent to, signed in with that (verified) email.
    function isRecipient() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == resource.data.recipientEmail;
    }

    // A sent document starts with creditOk == false; claimDocumentCredit flips it to true once it
    // has been counted against the sender's plan. Older documents have no creditOk at all.
    function isCounted() {
      return resource.data.get('creditOk', true) != false;
    }

    match /documents/{docId} {
      allow read: if isSignedIn() &&
        (isAdmin() || isWhatsAppSigner(docId) || request.auth.token.email == resource.data.ownerEmail || isRecipient());
      // Senders can't touch plan counting or the audit/seal fields, which only the server writes,
      // and can't change a document once it has been sealed.
      allow update: if isSignedIn() &&
        (isAdmin() || (request.auth.token.email == resource.data.ownerEmail &&
          !('documentHash' in resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['creditOk', 'documentHash', 'sealedAt', 'signerUid', 'viewedAt'])));
      // Recipients (by email, or by verified WhatsApp code) may only record their
      // signature on a pending document — nothing else.
      allow update: if (isRecipient() || isWhatsAppSigner(docId)) &&
        isCounted() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'signed' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'signature_data', 'signature_positions', 'signedAt']);
      allow create: if isSignedIn() &&
        request.auth.token.email == request.resource.data.ownerEmail &&
        request.resource.data.get('creditOk', null) == false;
      allow delete: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.ownerEmail);

      // Comments pinned to the document, visible to the owner and its signers.
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/documents/$(docId)).data;
        }
        function canAccessParent() {
          return isSignedIn() && (isAdmin() || isWhatsAppSigner(docId) ||
            request.auth.token.email == parent().ownerEmail ||
            (request.auth.token.email_verified == true && request.auth.token.email == parent().recipientEmail));
        }

        allow read: if canAccessParent();
        allow create: if canAccessParent() &&
          request.resource.data.keys().hasOnly(['text', 'page', 'x', 'y', 'authorUid', 'authorName', 'createdAt']) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.page is int &&
          request.resource.data.x is number &&
          request.resource.data.y is number &&
          request.resource.data.authorName is string &&
          request.resource.data.authorName.size() <= 120;
        allow delete: if canAccessParent() &&
          (resource.data.authorUid == request.auth.uid || request.auth.token.email == parent().ownerEmail);
        allow update: if false;
      }

      // Audit trail: written only by the server (Admin SDK), readable by the document's parties.
      match /audit/{eventId} {
        allow read: if isSignedIn() && (isAdmin() || isWhatsAppSigner(docId) ||
          request.auth.token.email == get(/databases/$(database)/documents/documents/$(docId)).data.ownerEmail ||
          (request.auth.token.email_verified == true &&
            request.auth.token.email == get(/databases/$(database)/documents/documents/$(docId)).data.recipientEmail));
        allow write: if false;
      }
    }

    // Documents uploaded on the dashboard, saved so the owner can come back to them.
    match /drafts/{draftId} {
      allow read, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;

      // The uploaded PDF, split into pieces.
      match /chunks/{chunkId} {
        allow read, write: if isSignedIn() &&
          get(/databases/$(database)/documents/drafts/$(draftId)).data.ownerUid == request.auth.uid;
      }
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
      allow create: if isSignedIn();
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.toEmail ||
         request.auth.token.email == resource.data.invitedBy || isTeamMember(resource.data.teamId));
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.invitedBy;
      // Status transitions (accept/expire) are only performed server-side via
      // the acceptTeamInvite Cloud Function, which uses the Admin SDK.
      allow update: if false;
      allow delete: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.invitedBy);
    }

    match /teams/{teamId} {
      allow read: if isAdmin() || isTeamMember(teamId);
      // Team documents are only created/modified server-side (createTeam,
      // removeTeamMember, acceptTeamInvite Cloud Functions).
      allow write: if false;

      match /members/{memberId} {
        allow read: if isAdmin() || isTeamMember(teamId);
        allow write: if false;
      }
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/documents/$(resource.data.documentId)).data.ownerEmail == request.auth.token.email);
      // Audit entries are only ever written by trusted server-side logic.
      allow write: if false;
    }

    match /templates/{templateId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Newsletter signups (public form). Document ID is the lowercased email, so a repeat
    // signup is an update — which isn't allowed — rather than a duplicate entry.
    match /newsletter_subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt']) &&
        request.resource.data.email == email &&
        email.size() <= 254 &&
        email.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$') &&
        email == email.lower() &&
        request.resource.data.source is string &&
        request.resource.data.source.size() <= 40 &&
        request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-only collections — never touched by client SDKs, only by Cloud
    // Functions via the Admin SDK (which bypasses these rules entirely).
    match /whatsapp_otps/{docId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
